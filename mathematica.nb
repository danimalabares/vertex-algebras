Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Weyl", " ", "character", " ", 
     RowBox[{"(", "A2", ")"}]}], "\[LongDash]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"alternant", " ", "numerator"}], "&"}], " ", 
      RowBox[{"denominator", ".", 
       RowBox[{"Variables", ":", "p"}]}]}], "=", 
     RowBox[{"e", "^", 
      RowBox[{"{", "\[Omega]1", "}"}]}]}], ",", 
    RowBox[{"q", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"e", "^", 
        RowBox[{"{", "\[Omega]2", "}"}]}], ".", 
       RowBox[{"Input", ":", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}]}]}], "=", 
      RowBox[{
      "coefficients", " ", "of", " ", "\[Lambda]", " ", "in", " ", 
       "fundamental", " ", 
       RowBox[{"weights", "."}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "S1", ",", "S2", ",", "W", ",", "rho", ",", "ApplyW", ",", "Monom", ",", 
      "Alternant", ",", "WeylCharND"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Simple", " ", "reflections", " ", "in", " ", "\[Omega]"}], 
       "-", 
       RowBox[{"basis", ":", 
        RowBox[{"s1", 
         RowBox[{"(", "\[Mu]", ")"}]}]}]}], "=", 
      RowBox[{
       RowBox[{"\[Mu]", "-"}], " ", "<", "\[Mu]"}]}], ",", 
     RowBox[{"\[Alpha]1", "\[Or]", 
      RowBox[{">", "\[Alpha]1"}]}], ",", 
     RowBox[{"\[Alpha]1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", ",", 
          RowBox[{"-", "1"}]}], ")"}], " ", "s2", 
        RowBox[{"(", "\[Mu]", ")"}]}], "=", 
       RowBox[{
        RowBox[{"\[Mu]", "-"}], " ", "<", "\[Mu]"}]}]}], ",", 
     RowBox[{"\[Alpha]2", "\[Or]", 
      RowBox[{">", "\[Alpha]2"}]}], ",", 
     RowBox[{"\[Alpha]2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"and", "<", "\[Omega]j"}], ",", 
         RowBox[{
          RowBox[{"\[Alpha]i", "\[Or]", ">"}], " ", "=", "\[Delta]ij"}], ",", 
         
         RowBox[{"so", "<", "\[Mu]"}], ",", 
         RowBox[{"\[Alpha]1", "\[Or]", 
          RowBox[{">", 
           RowBox[{"is", " ", "the", " ", "first", " ", 
            RowBox[{"coord", "."}]}]}]}], ",", 
         RowBox[{"etc", "."}]}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"S1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}]}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"columns", " ", "are", " ", "images", " ", "of", " ", "e1"}], 
      "=", 
      RowBox[{"(", 
       RowBox[{"1", ",", "0"}], ")"}]}], ",", 
     RowBox[{"e2", "=", 
      RowBox[{"(", 
       RowBox[{"0", ",", "1"}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"S2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"W", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "S1", ",", "S2", ",", 
       RowBox[{"S1", ".", "S2"}], ",", 
       RowBox[{"S2", ".", "S1"}], ",", 
       RowBox[{"S1", ".", "S2", ".", "S1"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], ";"}], "               ", 
   RowBox[{"(*", 
    RowBox[{"\[Rho]", "=", 
     RowBox[{"\[Omega]1", "+", "\[Omega]2"}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ApplyW", "[", 
      RowBox[{"m_", ",", "v_"}], "]"}], ":=", 
     RowBox[{"m", ".", "v"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Monom", "[", 
      RowBox[{"{", 
       RowBox[{"i_", ",", "j_"}], "}"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"p", "^", "i"}], "*", 
      RowBox[{"q", "^", "j"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternant", "[", "v_", "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Det", "[", "#", "]"}], "*", 
          RowBox[{"Monom", "[", 
           RowBox[{"ApplyW", "[", 
            RowBox[{"#", ",", "v"}], "]"}], "]"}]}], ")"}], "&"}], "/@", 
       "W"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", 
     RowBox[{"function", ":", 
      RowBox[{"returns", " ", 
       RowBox[{"{", 
        RowBox[{"Numerator", ",", "Denominator"}], "}"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"WeylCharND", "[", 
      RowBox[{"{", 
       RowBox[{"a_Integer", ",", "b_Integer"}], "}"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lamRho", ",", "num", ",", "den"}], "}"}], ",", 
       RowBox[{
        RowBox[{"lamRho", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "+", "1"}], ",", 
           RowBox[{"b", "+", "1"}]}], "}"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"\[Lambda]", "+", 
          RowBox[{"\[Rho]", " ", "in", " ", "\[Omega]"}], "-", "basis"}], 
         "*)"}], 
        RowBox[{"num", "=", 
         RowBox[{"Expand", "@", 
          RowBox[{"Alternant", "[", "lamRho", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"den", "=", 
         RowBox[{"Expand", "@", 
          RowBox[{"Alternant", "[", "rho", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"num", ",", "den"}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"WeylChar", "[", 
     RowBox[{"{", 
      RowBox[{"a_Integer", ",", "b_Integer"}], "}"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Together", "@", "Divide"}], "@@", 
      RowBox[{"WeylCharND", "[", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}], "]"}]}], 
     RowBox[{"\[AliasDelimiter]", "\n"}]}]}]}]}]], "Input",
